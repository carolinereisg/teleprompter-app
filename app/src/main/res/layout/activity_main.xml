<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Cabeçalho com assinatura no canto -->
    <FrameLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Teleprompter"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:text="Traga seu roteiro. O resto você ajusta com a câmera ligada."
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/brandLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_brand_pill"
            android:gravity="end"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="Serenidade Lab\npor @carolinereisg"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ROTEIRO (o essencial) -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="Seu roteiro" />

                    <TextView
                        style="@style/SectionHint"
                        android:text="Word (.docx) ou .txt, colado ou digitado. A formatação do documento é mantida." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/importBtn"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="📄  Importar arquivo Word ou TXT"
                        android:textSize="16sp"
                        app:cornerRadius="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pasteBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:text="📋  Colar"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/clearBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Limpar"
                            app:cornerRadius="16dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sourceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="12sp"
                        android:textStyle="italic" />

                    <EditText
                        android:id="@+id/scriptEdit"
                        android:layout_width="match_parent"
                        android:layout_height="340dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_editor"
                        android:gravity="top|start"
                        android:hint="Seu texto aparece aqui, do jeito que vai ficar no teleprompter…"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingMultiplier="1.15"
                        android:padding="16dp"
                        android:scrollbars="vertical"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/statsText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="12sp" />

                    <TextView
                        style="@style/SectionHint"
                        android:layout_marginTop="4dp"
                        android:text="Tamanho da letra, velocidade e transparência você ajusta na tela da câmera, no botão Aa." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GRAVAÇÃO E CÂMERA (recolhível) -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/recHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="🎥  Gravação e câmera" />

                        <TextView
                            android:id="@+id/recArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/recSummary"
                        style="@style/SectionHint"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:id="@+id/recContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Orientação" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/orientationGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPortrait"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="▯ Vertical" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnLandscape"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="▭ Horizontal" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Qualidade" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/qualityGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnFhd"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Full HD" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUhd"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="4K" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Tempo de gravação" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/durationGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/durFree"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Livre" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/dur30"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 s" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/dur60"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 min" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/dur180"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="3 min" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/durCustom"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personalizado" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:id="@+id/customRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/customMin"
                                android:layout_width="70dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:hint="0"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" min   " />

                            <EditText
                                android:id="@+id/customSec"
                                android:layout_width="70dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:hint="0"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:maxLength="2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" s" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/frontSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Começar com a câmera frontal" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/countdownSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Contagem regressiva de 3 s" />

                        <TextView
                            style="@style/SectionHint"
                            android:layout_marginTop="4dp"
                            android:text="Câmera USB (ex.: Insta360 Link 2): conecte antes de abrir a câmera; o app a usa automaticamente. O botão ⟲ alterna entre as câmeras." />

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Enquadramento para cortes" />

                        <TextView
                            android:id="@+id/framingHint"
                            style="@style/SectionHint" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/guidesSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mostrar linhas de corte 9:16 e 16:9" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/silhouetteSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mostrar silhueta durante a gravação" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CONTROLES (recolhível) -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ctlHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="🖱  Controles sem tocar na tela" />

                        <TextView
                            android:id="@+id/ctlArrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/ctlSummary"
                        style="@style/SectionHint"
                        android:layout_marginBottom="0dp" />

                    <LinearLayout
                        android:id="@+id/ctlContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Mouse Bluetooth (ex.: MX Anywhere)" />

                        <TextView
                            android:id="@+id/mouseStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pairMouseBtn"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parear mouse no Bluetooth" />

                        <TextView
                            style="@style/SectionHint"
                            android:text="Clique esquerdo: segura / solta o texto.\nRodinha para cima: o texto volta.\nRodinha para baixo: o texto acelera até alcançar sua fala." />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/adaptiveSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ritmo adaptativo: após 3 correções no mesmo sentido, a velocidade se ajusta" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/gestureSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Mão aberta ✋ pausa / retoma a gravação" />

                        <TextView
                            style="@style/FieldLabel"
                            android:text="Botões de volume ou passador de slides" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/remoteGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemotePos"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ajustar posição" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRemoteSpeed"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Ajustar velocidade" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <TextView
                            style="@style/SectionHint"
                            android:layout_marginTop="6dp"
                            android:text="▲ / volume +: texto volta (ou fica mais lento).\n▼ / volume −: texto avança (ou fica mais rápido).\nPlay / Enter: pausa e retoma." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DIVIDIR VÍDEO -->
            <com.google.android.material.card.MaterialCardView style="@style/SectionCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="✂️  Dividir vídeo grande" />

                    <TextView
                        style="@style/SectionHint"
                        android:text="Escolha um vídeo acima de 398 MB. O app faz cópias em partes de ~380 MB (cada uma toca sozinha) e salva em sequência na pasta Movies/Teleprompter/nome_partes. O original não é alterado." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/splitBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Escolher vídeo para dividir"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/splitProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:max="100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/splitStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/footerBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:alpha="0.6"
                android:gravity="center"
                android:padding="8dp"
                android:text="Serenidade Lab · por @carolinereisg"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Botão principal fixo -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="🎬  Abrir câmera"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="30dp" />
    </LinearLayout>
</LinearLayout>
