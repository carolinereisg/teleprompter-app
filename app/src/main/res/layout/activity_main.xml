<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teleprompter"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Texto do roteiro"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/scriptEdit"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:hint="Cole ou digite aqui o seu texto…"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="10dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pasteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Colar texto" />

            <Button
                android:id="@+id/clearBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Limpar" />
        </LinearLayout>

        <TextView
            android:id="@+id/charCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/fontLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/fontSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="16"
            android:max="96" />

        <TextView
            android:id="@+id/speedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="1"
            android:max="20" />

        <TextView
            android:id="@+id/opacityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/opacitySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="90" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tempo de gravação"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/durationGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/durFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Livre (sem limite)" />

            <RadioButton
                android:id="@+id/dur30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 segundos" />

            <RadioButton
                android:id="@+id/dur60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 minuto" />

            <RadioButton
                android:id="@+id/dur180"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 minutos" />

            <RadioButton
                android:id="@+id/durCustom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personalizado" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/customRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp">

            <EditText
                android:id="@+id/customMin"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" min  " />

            <EditText
                android:id="@+id/customSec"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:hint="0"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" s" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Opções"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/gestureSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="Mão aberta ✋ pausa / retoma a gravação" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/countdownSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="Contagem regressiva de 3 s antes de gravar" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/frontSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="Começar com a câmera frontal" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/landscapeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="6dp"
            android:text="Gravar na horizontal (paisagem)" />

        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/brand"
            android:text="Abrir câmera"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Os vídeos ficam salvos na galeria, pasta Movies/Teleprompter."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
