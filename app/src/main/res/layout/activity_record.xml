<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Imagem da câmera: mostra o quadro inteiro que será gravado -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Imagem da câmera USB (Insta360 etc.), usada no lugar da câmera do celular -->
    <FrameLayout
        android:id="@+id/usbContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.jiangdg.ausbc.widget.AspectRatioTextureView
            android:id="@+id/usbView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Teleprompter em tela cheia, com fundo semitransparente -->
    <ScrollView
        android:id="@+id/prompterScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <TextView
            android:id="@+id/prompterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.25"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="#FFFFFF" />
    </ScrollView>

    <!-- Linha-guia de leitura -->
    <View
        android:id="@+id/guideLine"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="#88E3A857" />

    <!-- Guias de corte e silhueta (não aparecem no vídeo) -->
    <com.serenidadelab.teleprompter.FramingOverlay
        android:id="@+id/framingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Moldura de estado: vermelha = gravando, amarela piscando = pausado -->
    <View
        android:id="@+id/statusBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Selo de estado -->
    <TextView
        android:id="@+id/statusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="28dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/timerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gestureIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:alpha="0.35"
            android:text="✋"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/settingsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="end"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/textBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_button"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="Aa"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/frameBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_button"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="▦"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/flipBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_button"
            android:minWidth="48dp"
            android:paddingHorizontal="10dp"
            android:text="⟲"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Barra de tamanho do arquivo (modo Edição com Claude) -->
    <LinearLayout
        android:id="@+id/sizeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="84dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/sizeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="@color/accent" />

        <TextView
            android:id="@+id/sizeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Painel de ajustes do texto (com a câmera ligada) -->
    <ScrollView
        android:id="@+id/textPanel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="84dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/bg_panel"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes do texto"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panelFontLabel"
                style="@style/PanelLabel" />

            <SeekBar
                android:id="@+id/panelFont"
                style="@style/PanelSeek"
                android:max="40" />

            <TextView
                android:id="@+id/panelSpeedLabel"
                style="@style/PanelLabel" />

            <SeekBar
                android:id="@+id/panelSpeed"
                style="@style/PanelSeek"
                android:max="40" />

            <TextView
                android:id="@+id/panelOpacityLabel"
                style="@style/PanelLabel" />

            <SeekBar
                android:id="@+id/panelOpacity"
                style="@style/PanelSeek"
                android:max="18" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/panelBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tudo em negrito"
                android:textColor="#FFFFFF" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/panelColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cores e marca-texto do documento"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/panelPlay"
                    style="@style/PromptBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="▶ Testar rolagem" />

                <Button
                    android:id="@+id/panelClose"
                    style="@style/PromptBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="✓ Pronto" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Contagem regressiva -->
    <TextView
        android:id="@+id/countdownText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:shadowColor="#000000"
        android:shadowRadius="12"
        android:textColor="#FFFFFF"
        android:textSize="120sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Barra inferior -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="24dp"
        android:background="@color/bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/leftCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/fontMinus"
                    style="@style/PromptBtn"
                    android:text="A−" />

                <Button
                    android:id="@+id/fontPlus"
                    style="@style/PromptBtn"
                    android:text="A+" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/speedMinus"
                    style="@style/PromptBtn"
                    android:text="🐢" />

                <Button
                    android:id="@+id/speedPlus"
                    style="@style/PromptBtn"
                    android:text="🐇" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/recordBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_record"
            android:text="REC"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rightCol"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/pauseBtn"
                style="@style/PromptBtn"
                android:layout_width="110dp"
                android:text="⏸ Pausar" />

            <Button
                android:id="@+id/playTextBtn"
                style="@style/PromptBtn"
                android:layout_width="110dp"
                android:layout_marginTop="6dp"
                android:text="▶ Texto" />

            <Button
                android:id="@+id/rewindBtn"
                style="@style/PromptBtn"
                android:layout_width="110dp"
                android:layout_marginTop="6dp"
                android:text="⤒ Início" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
