<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="brand">#6B4E9B</color>
    <color name="brand_dark">#4A3470</color>
    <color name="accent">#E3A857</color>
    <color name="rec_red">#E53935</color>
    <color name="bar_bg">#99000000</color>

    <style name="Theme.Teleprompter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
    </style>

    <style name="Theme.Teleprompter.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
